<Window
    x:Class="MyContent.Views.AuthWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="880"
    Height="680"
    MinWidth="760"
    MinHeight="600"
    Title="My Content"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F4FA" />
    </Style>
    <Style Selector="Button.primary-auth">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111318" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22,18" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary-auth:pointerover">
      <Setter Property="Opacity" Value="0.94" />
      <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button.ghost-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#B8C0D4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.ghost-action:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.inline-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#A99BFF" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.inline-link:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </Window.Styles>

  <Border Padding="36">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#07090F" />
        <GradientStop Offset="0.55" Color="#12172A" />
        <GradientStop Offset="1" Color="#1B1433" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="16">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#D9D3FF" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#16121F" Text="MC" />
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="My Content" />
            <TextBlock FontSize="13" Opacity="0.58" Text="Creator intelligence" />
          </StackPanel>
        </StackPanel>
        <Button
            x:Name="UpdateButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="ghost-action"
            Click="OnUpdateClicked"
            Content="Checking updates..." />
      </Grid>

      <Grid Grid.Row="1" Margin="0,28,0,16">
        <Border
            MaxWidth="720"
            Padding="36"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="#141826"
            BorderBrush="#2A3148"
            BorderThickness="1"
            BoxShadow="0 24 70 0 #66000000"
            CornerRadius="28">
          <StackPanel Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock FontSize="34" FontWeight="SemiBold" Text="Welcome to My Content" TextWrapping="Wrap" />
              <TextBlock FontSize="16" Opacity="0.62" Text="One Google sign-in. Your creator workspace starts here." TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding !IsAuthenticated}">
              <Button
                  Classes="primary-auth"
                  Command="{Binding SignInWithGoogleCommand}"
                  Content="Continue with Google"
                  IsDefault="True" />

              <TextBlock Opacity="0.55" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

              <Border
                  Padding="12,10"
                  Background="#3A1520"
                  CornerRadius="12"
                  IsVisible="{Binding HasError}">
                <TextBlock Foreground="#FF8A96" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
              </Border>

              <CheckBox IsChecked="{Binding TermsAccepted, Mode=TwoWay}" HorizontalContentAlignment="Left">
                <WrapPanel>
                  <TextBlock VerticalAlignment="Center" Opacity="0.72" Text="I agree to the " />
                  <Button Classes="inline-link" Click="OnTermsClicked" Content="Terms of Service" />
                  <TextBlock VerticalAlignment="Center" Opacity="0.72" Text=" and " />
                  <Button Classes="inline-link" Click="OnCookieClicked" Content="Cookie Notice" />
                </WrapPanel>
              </CheckBox>
            </StackPanel>

            <StackPanel Spacing="14" IsVisible="{Binding IsAuthenticated}">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="You are signed in" />
              <TextBlock Opacity="0.7" Text="{Binding AuthenticatedEmail}" TextWrapping="Wrap" />
              <TextBlock Opacity="0.55" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
              <Button Classes="primary-auth" Command="{Binding SignOutCommand}" Content="Sign out" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Grid.Row="2" HorizontalAlignment="Center" Opacity="0.38" Text="My Content  -  Built for creators" />
    </Grid>
  </Border>
</Window>
