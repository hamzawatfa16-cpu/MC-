<Window
    x:Class="MyContent.Views.LegalDocumentWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="640"
    MinWidth="520"
    MinHeight="420"
    Background="#10131C"
    Title="My Content"
    WindowStartupLocation="CenterOwner">
  <Border Padding="28" Background="#10131C">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="#F2F4FA" />
      <ScrollViewer Grid.Row="1" Margin="0,18,0,18">
        <TextBlock x:Name="DocumentText" FontSize="14" LineHeight="22" Foreground="#D5DCEC" TextWrapping="Wrap" />
      </ScrollViewer>
      <Button Grid.Row="2" HorizontalAlignment="Right" Content="Close" Click="OnCloseClicked" />
    </Grid>
  </Border>
</Window>
